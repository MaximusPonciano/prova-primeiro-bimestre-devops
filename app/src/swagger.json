{
  "openapi": "3.0.0",
  "info": {
    "title": "API de Reservas - TechNova",
    "version": "1.0.0",
    "description": "Documentação oficial da API de Reservas da TechNova."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor de Desenvolvimento Local"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Verifica se a aplicação e o banco de dados estão saudáveis.",
        "responses": {
          "200": {
            "description": "Serviços funcionando corretamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "db": { "type": "string", "example": "connected" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Banco de dados desconectado."
          }
        }
      }
    },
    "/reservas": {
      "get": {
        "summary": "Lista de Reservas",
        "description": "Retorna todas as reservas cadastradas.",
        "responses": {
          "200": {
            "description": "Lista de reservas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Reserva" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Cria uma nova Reserva",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarReservaInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reserva criada com sucesso.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Reserva" }
              }
            }
          },
          "400": {
            "description": "Erro de validação nos dados enviados."
          }
        }
      }
    },
    "/reservas/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer" }
        }
      ],
      "get": {
        "summary": "Busca Reserva por ID",
        "responses": {
          "200": {
            "description": "Dados da reserva.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Reserva" }
              }
            }
          },
          "404": {
            "description": "Reserva não encontrada."
          }
        }
      },
      "put": {
        "summary": "Atualiza uma Reserva",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CriarReservaInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reserva atualizada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Reserva" }
              }
            }
          },
          "400": {
            "description": "Erro de validação."
          },
          "404": {
            "description": "Reserva não encontrada."
          }
        }
      },
      "delete": {
        "summary": "Exclui uma Reserva",
        "responses": {
          "200": {
            "description": "Reserva excluída."
          },
          "404": {
            "description": "Reserva não encontrada."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Reserva": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "cliente": { "type": "string", "example": "Maximus Ponciano" },
          "data": { "type": "string", "format": "date-time", "example": "2026-10-15T19:00:00Z" },
          "status": { "type": "string", "enum": ["pendente", "confirmada", "cancelada"], "example": "pendente" }
        }
      },
      "CriarReservaInput": {
        "type": "object",
        "required": ["cliente", "data"],
        "properties": {
          "cliente": { "type": "string", "example": "Maximus Ponciano" },
          "data": { "type": "string", "format": "date-time", "example": "2026-10-15T19:00:00Z" },
          "status": { "type": "string", "enum": ["pendente", "confirmada", "cancelada"], "example": "pendente" }
        }
      }
    }
  }
}
